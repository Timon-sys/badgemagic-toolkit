 {
-	int ret = EEPROM_READ(flash_offs, cfg, CFG_SIZE);
+	int ret = EEPROM_READ(flash_offs, cfg_buf, CFG_SIZE);
 	if (ret)
 		return ret;
+	memcpy(cfg, cfg_buf, CFG_SIZE);
 
-	return crc_cal((uint8_t *)cfg, CFG_SIZE);
+	return cfg_crc((uint8_t *)cfg, CFG_SIZE);
 }
 
