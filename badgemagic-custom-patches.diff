@@ -12,14 +13,34 @@
 #include <stdlib.h>
 
 #define CFG_SIZE sizeof(badge_cfg_t)
-#define CFG_DEF_FLASH_OFFS (EEPROM_MAX_SIZE - CFG_SIZE - 1) // Default offset
+/* Upstream put the config at the very end (0x7ED7..0x7FFE). That overlapped
+ * the game highscore at 0x7FF8, whose page erase wiped the config tail, and
+ * the config itself was written without an erase, so every save ANDed the new
+ * bits into the old ones until everything read back as 0 - which the plain
+ * CRC (init 0) accepted as valid: name "", always-on off, brightness 0.
+ * Now: own page-aligned area, erase before write, CRC seeded so all-zero and
+ * all-0xFF data never validate. */
+#define CFG_DEF_FLASH_OFFS (0x7C00)
+#define CFG_AREA_SIZE      (((CFG_SIZE) + EEPROM_PAGE_SIZE - 1) / EEPROM_PAGE_SIZE * EEPROM_PAGE_SIZE)
+#define CFG_CRC_SEED       (0xA5)
+
+/* EEPROM_READ/WRITE need 4-byte aligned buffers; badge_cfg_t is packed. */
+static uint32_t cfg_buf[(CFG_SIZE + 3) / 4];
+
+static uint8_t cfg_crc(uint8_t *a, int len)
+{
+	uint8_t crc = CFG_CRC_SEED;
+	for (int i = 0; i < len; i++)
+		crc = crc8_ccitt_update(crc, a[i]);
+	return crc;
+}
 
 badge_cfg_t badge_cfg;
 
 /* In case of first time firmware upgrading */
