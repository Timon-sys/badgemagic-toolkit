@@ -27,7 +48,7 @@ void cfg_fallback()
 	badge_cfg.led_brightness = 0;
 	badge_cfg.led_scan_freq = 2000;
 
-	badge_cfg.splash_speedT = 30; // ms
+	badge_cfg.splash_speedT = 0; // ms, 0 = no startup animation
 
 	int splash_size = ALIGN_1BYTE(splash.w) * splash.h;
 	memcpy(badge_cfg.splash_bm_bits, splash.bits, splash_size);
@@ -41,7 +62,7 @@ void cfg_fallback()
 
 void cfg_update_crc(badge_cfg_t *cfg)
 {
-	cfg->crc = crc_cal((uint8_t *)cfg, CFG_SIZE - 1);
+	cfg->crc = cfg_crc((uint8_t *)cfg, CFG_SIZE - 1);
 	PRINT(__func__);
 	PRINT(": crc: %02X\n", cfg->crc);
 }
@@ -51,17 +72,24 @@ int cfg_writeflash(uint16_t flash_offs, badge_cfg_t *cfg)
 	if (flash_offs + CFG_SIZE > EEPROM_MAX_SIZE) {
 		return -1;
 	}
-	cfg_update_crc(&badge_cfg);
-	return EEPROM_WRITE(flash_offs, cfg, CFG_SIZE);
+	cfg_update_crc(cfg);
+	memcpy(cfg_buf, cfg, CFG_SIZE);
+	leds_pause();
+	int r = EEPROM_ERASE(flash_offs, CFG_AREA_SIZE);
+	if (!r)
+		r = EEPROM_WRITE(flash_offs, cfg_buf, CFG_SIZE);
+	leds_resume();
+	return r;
 }
 
