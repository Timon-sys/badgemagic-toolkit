+/* Bonds (pairing keys) live right below the config (0x7C00..0x7DFF); the
+ * slots grow from 0 and are far smaller, they have to fit in RAM first.
+ * One block per bonded device, two devices (say a PC and a phone): with a
+ * single block, pairing the phone pushed out the PC. A third device makes
+ * the stack erase all bonds. Upstream left SNVAddr at 0, nothing was kept. */
+#define BLE_SNV_NUM                         2
+#define BLE_SNV_BLOCK                       (EEPROM_PAGE_SIZE)
+#define BLE_SNV_ADDR                        (0x7C00 - BLE_SNV_BLOCK * BLE_SNV_NUM)
+
+/* LE Secure Connections needs BufMaxLen > 69 (see bleConfig_t), so the
+ * builds with the 68-byte buffer fall back to legacy passkey pairing. */
+const uint8_t ble_sc_ok = BLE_BUFF_LEN > 69;
+
 static __attribute__((aligned(4), section(".noinit")))
 uint32_t MEM_BUF[BLE_MEMHEAP_SIZE / 4];
 
+static uint32_t snv_read(uint32_t addr, uint32_t num, uint32_t *buf)
+{
+	EEPROM_READ(addr, buf, num * 4);
+	return 0;
+}
+
+/* WCH's sample erases two pages from addr whatever it writes, which could
+ * reach the config, so erase just the pages being written (other bonds
+ * sit in the other blocks). */
+static uint32_t snv_write(uint32_t addr, uint32_t num, uint32_t *buf)
+{
+	if (addr < BLE_SNV_ADDR || addr + num * 4 > BLE_SNV_ADDR + BLE_SNV_BLOCK * BLE_SNV_NUM)
+		return 1;
+	uint32_t start = addr / EEPROM_PAGE_SIZE * EEPROM_PAGE_SIZE;
+	uint32_t end = (addr + num * 4 + EEPROM_PAGE_SIZE - 1) / EEPROM_PAGE_SIZE * EEPROM_PAGE_SIZE;
+	leds_pause();
+	uint32_t r = EEPROM_ERASE(start, end - start);
+	if (!r)
+		r = EEPROM_WRITE(addr, buf, num * 4);
+	leds_resume();
+	return r;
+}
