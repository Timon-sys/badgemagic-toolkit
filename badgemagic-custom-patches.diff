+/* Number of LED_COLS-wide pages the paged modes show. Widths arrive in
+ * 8-column blocks, so a full-width (44) picture is stored as 48 columns and
+ * its last page is only padding: shown as a page of its own, the display went
+ * dark every other page. Drop a last page that is partial and blank. */
+static int page_count(bm_t *bm)
+{
+	int frames = ALIGN(bm->width, LED_COLS) / LED_COLS;
+	if (frames <= 1 || bm->width % LED_COLS == 0)
+		return frames;
+	for (int i = (frames - 1) * LED_COLS; i < bm->width; i++) {
+		if (bm->buf[i])
+			return frames;
+	}
+	return frames - 1;
+}
