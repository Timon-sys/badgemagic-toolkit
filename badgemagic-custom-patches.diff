+/* ng protocol over USB (HID + CDC).
+ *
+ * The legacy protocol claims any transfer starting with the "wang" magic, so we only
+ * take packets carrying our own magic, and only while legacy is idle:
+ *
+ *   'N' 'G' len_lo len_hi payload[len]
+ *
+ * A payload can span several USB packets -- HID reports are 64 bytes and a
+ * full 44x11 frame is 88 -- so reassemble before handing it to ng_parse().
+ */
+#define NG_USB_HDR_LEN  4
+#define NG_USB_BUF_SIZE 320
+
+static uint8_t  ng_usb_buf[NG_USB_BUF_SIZE];
+static uint16_t ng_usb_expect;
+static uint16_t ng_usb_have;
