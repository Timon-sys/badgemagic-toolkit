+/* Security on: the badge asks a client to pair as soon as it connects, with
+ * the PIN as passkey (MITM protected), and keeps the bond, so each device
+ * types the PIN once, like with a Meshtastic node. The profiles then refuse
+ * writes from links that aren't paired (ble_link_allowed()).
+ * Security off: nothing is asked for or needed, but a client that bonded
+ * earlier can still encrypt with its bond instead of failing to reconnect.
+ * Upstream had pairing switched off and a 4-digit code sent in clear text
+ * that only guarded slot uploads. Takes effect for the next connection. */
+void ble_apply_security()
+{
+	uint32 passkey = badge_cfg.ble_passkey;
+	uint8 pairMode = badge_cfg.ble_security ? GAPBOND_PAIRING_MODE_INITIATE
+	                                        : GAPBOND_PAIRING_MODE_WAIT_FOR_REQ;
+	uint8 on = TRUE;
+	uint8 sc = ble_sc_ok;
+	uint8 ioCap = GAPBOND_IO_CAP_DISPLAY_ONLY;
+	GAPBondMgr_SetParameter(GAPBOND_PERI_DEFAULT_PASSCODE, sizeof(uint32), &passkey);
+	GAPBondMgr_SetParameter(GAPBOND_PERI_PAIRING_MODE, sizeof(uint8), &pairMode);
+	GAPBondMgr_SetParameter(GAPBOND_PERI_MITM_PROTECTION, sizeof(uint8), &on);
+	GAPBondMgr_SetParameter(GAPBOND_PERI_IO_CAPABILITIES, sizeof(uint8), &ioCap);
+	GAPBondMgr_SetParameter(GAPBOND_PERI_BONDING_ENABLED, sizeof(uint8), &on);
+	GAPBondMgr_SetParameter(GAPBOND_PERI_SC_PROTECTION, sizeof(uint8), &sc);
+}
+
+static void drop_link()
+{
+	if (conn_list.connHandle != GAP_CONNHANDLE_INIT)
+		GAPRole_TerminateLink(conn_list.connHandle);
+}
+
+/* The USB commands below run in the USB ISR, where the BLE lib must not be
+ * called, so they only flag the work for this task. */
+static uint8 sec_taskid = INVALID_TASK_ID;
+#define SEC_UPDATE_EVT 0x0001
+static volatile uint8_t sec_forget;
+static volatile uint8_t sec_changed;
+
+/* address type + address of a peer whose bond has to go */
+static uint8 unauth_peer[1 + B_ADDR_LEN];
+static uint8_t unauth_pending;
+static uint16 unauth_handle;
+
+static void find_unauth_peer(linkDBItem_t *it)
+{
+	if (it->connectionHandle != unauth_handle)
+		return;
+	unauth_peer[0] = it->addrType;
+	tmos_memcpy(&unauth_peer[1], it->addr, B_ADDR_LEN);
+	unauth_pending = 1;
+}
+
+/* Erasing from inside the bond manager's own callback isn't safe, so
+ * note the peer and let the task do it. */
+static void reject_unauth_bond(uint16 connHandle)
+{
+	unauth_handle = connHandle;
+	linkDB_PerformFunc(find_unauth_peer);
+	tmos_set_event(sec_taskid, SEC_UPDATE_EVT);
+}
+
+static uint16 security_task(uint8 task_id, uint16 events)
+{
+	if (events & SEC_UPDATE_EVT) {
+		if (unauth_pending) {
+			unauth_pending = 0;
+			GAPBondMgr_SetParameter(GAPBOND_ERASE_SINGLEBOND,
+						sizeof(unauth_peer), unauth_peer);
+			drop_link();
+		}
+		if (sec_forget) {
+			sec_forget = 0;
+			GAPBondMgr_SetParameter(GAPBOND_ERASE_ALLBONDS, 0, NULL);
+			drop_link();
+		}
+		ble_apply_security();
+		/* A client connected without pairing (or paired with the old PIN)
+		 * has to pair again. */
+		if (badge_cfg.ble_security)
+			drop_link();
+		if (sec_changed) {
+			sec_changed = 0;
+			bt_pairing_refresh();
+		}
+		return events ^ SEC_UPDATE_EVT;
+	}
+	return 0;
+}
+
+/* After ble_security or ble_passkey changed */
+void ble_security_changed()
+{
+	sec_changed = 1;
+	tmos_set_event(sec_taskid, SEC_UPDATE_EVT);
+}
+
+int ble_link_allowed(uint16_t connHandle)
+{
+	if (!badge_cfg.ble_security || sec_bypass)
+		return 1;
+	return linkDB_State(connHandle, LINK_ENCRYPTED)
+	       && linkDB_State(connHandle, LINK_AUTHENTICATED);
+}
+
+void ble_security_bypass()
+{
+	sec_bypass = 1;
+}
+
+void ble_security_bypass_end()
+{
+	sec_bypass = 0;
+}
+
+/* Erases every bond and drops the current client */
+void ble_forget_bonds()
+{
+	sec_forget = 1;
+	tmos_set_event(sec_taskid, SEC_UPDATE_EVT);
+}
+
+uint8_t ble_bond_count()
+{
+	uint8 n = 0;
+	GAPBondMgr_GetParameter(GAPBOND_BOND_COUNT, &n);
+	return n;
+}
