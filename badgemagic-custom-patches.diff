+int ng_usb_rx(uint8_t *buf, uint16_t len)
+{
+	if (ng_usb_have == 0) {
+		if (legacy_usb_busy() || len < NG_USB_HDR_LEN
+		    || buf[0] != 'N' || buf[1] != 'G')
+			return legacy_usb_rx(buf, len);
+
+		ng_usb_expect = buf[2] | (buf[3] << 8);
+		if (ng_usb_expect == 0 || ng_usb_expect > NG_USB_BUF_SIZE) {
+			ng_usb_expect = 0;
+			return -1;
+		}
+
+		buf += NG_USB_HDR_LEN;
+		len -= NG_USB_HDR_LEN;
+	}
+
+	if (len > ng_usb_expect - ng_usb_have)
+		len = ng_usb_expect - ng_usb_have;
+	tmos_memcpy(ng_usb_buf + ng_usb_have, buf, len);
+	ng_usb_have += len;
+
+	if (ng_usb_have < ng_usb_expect)
+		return 0;
+
+	ng_parse(ng_usb_buf, ng_usb_expect);
+	ng_usb_have = 0;
+	ng_usb_expect = 0;
+	return 0;
+}
